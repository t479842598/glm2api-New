#!/usr/bin/expect -f
set timeout 300
spawn ssh -o StrictHostKeyChecking=no root@182.92.127.90
expect "password:"
send "TANGlidong24ban!\r"
expect "# "

send "cd /opt/glm2api\r"
expect "# "

send "cat > Dockerfile << 'EOF'\r"
expect ">"
send "FROM python:3.12-slim\r"
expect ">"
send "WORKDIR /app\r"
expect ">"
send "COPY . .\r"
expect ">"
send "RUN pip install --no-cache-dir -e .\r"
expect ">"
send "EXPOSE 8000\r"
expect ">"
send "CMD [\"python\", \"-m\", \"glm2api\"]\r"
expect ">"
send "EOF\r"
expect "# "

send "cat Dockerfile\r"
expect "# "

send "docker build -t glm2api . 2>&1 | tail -15\r"
expect -timeout 300 "# "

send "docker run -d --name glm2api -p 127.0.0.1:8000:8000 --restart unless-stopped -e HOST=0.0.0.0 -e GLM_USE_GUEST_REFRESH_TOKEN=true -e ADMIN_KEY=glm2api-admin glm2api\r"
expect "# "

send "sleep 5 && docker ps | grep glm2api\r"
expect "# "

send "docker logs glm2api 2>&1 | tail -10\r"
expect "# "

send "exit\r"
expect eof
