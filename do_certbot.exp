#!/usr/bin/expect -f
set timeout 120

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@23.95.78.148
expect "password:"
send "TANGlidong24ban\r"
expect "# "

# Check DNS
send "echo '=== DNS check ===' && dig +short glm2api.274747.xyz @1.1.1.1 2>&1\r"
expect "# "

# Check current nginx config
send "cat /etc/nginx/sites-available/glm2api.conf\r"
expect "# "

# Install certbot
send "apt-get update -qq 2>&1 | tail -3 && apt-get install -y certbot python3-certbot-nginx -qq 2>&1 | tail -5\r"
expect -timeout 120 "# "

send "certbot --version\r"
expect "# "

# Run certbot with standalone mode (avoids nginx redirect conflict)
send "systemctl stop nginx 2>/dev/null; certbot certonly --standalone -d glm2api.274747.xyz --non-interactive --agree-tos --email admin@274747.xyz 2>&1 | tail -15\r"
expect -timeout 60 "# "

send "systemctl start nginx 2>/dev/null\r"
expect "# "

# Verify cert
send "ls -la /etc/letsencrypt/live/glm2api.274747.xyz/ 2>&1\r"
expect "# "

# Update nginx to use Let's Encrypt cert
send "cat > /etc/nginx/sites-available/glm2api.conf << 'NGX'\nserver {\n    listen 80;\n    server_name glm2api.274747.xyz;\n    return 301 https://\$server_name\$request_uri;\n}\n\nserver {\n    listen 443 ssl http2;\n    server_name glm2api.274747.xyz;\n\n    ssl_certificate /etc/letsencrypt/live/glm2api.274747.xyz/fullchain.pem;\n    ssl_certificate_key /etc/letsencrypt/live/glm2api.274747.xyz/privkey.pem;\n    ssl_protocols TLSv1.2 TLSv1.3;\n\n    client_max_body_size 100M;\n\n    location / {\n        proxy_pass http://127.0.0.1:8001;\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade \$http_upgrade;\n        proxy_set_header Connection \"upgrade\";\n        proxy_set_header Host \$host;\n        proxy_set_header X-Real-IP \$remote_addr;\n        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto \$scheme;\n        proxy_buffering off;\n        proxy_read_timeout 600s;\n    }\n}\nNGX\r"
expect "# "

send "nginx -t && systemctl reload nginx && echo NGINX_OK\r"
expect "# "

send "curl -sk https://glm2api.274747.xyz/health 2>&1\r"
expect "# "

send "echo DONE\r"
expect "# "
send "exit\r"
expect eof
