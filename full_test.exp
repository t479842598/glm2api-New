spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@23.95.78.148
expect "password:"
send "TANGlidong24ban\r"
expect "# "

send "echo '=== Test login POST ===' && curl -s -w '\\nHTTP_CODE:%{http_code}' -X POST https://glm2api.274747.xyz/admin/api/login -H 'Content-Type: application/json' -d '{\"key\":\"glm2api-admin\"}' -c /tmp/cookies.txt 2>&1 | tail -5\r"
