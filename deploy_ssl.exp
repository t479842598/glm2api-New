#!/usr/bin/expect -f
set timeout 30
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@23.95.78.148
expect "password:"
send "TANGlidong24ban\r"
expect "# "

send "DOMAIN=glm.tang74.top\r"
expect "# "

# Generate self-signed cert
send "mkdir -p /etc/nginx/ssl && openssl req -x509 -nodes -days 3650 -newkey rsa:2048 -keyout /etc/nginx/ssl/\$DOMAIN.key -out /etc/nginx/ssl/\$DOMAIN.crt -subj '/C=CN/ST=Beijing/O=glm2api/CN=\$DOMAIN' 2>/dev/null && chmod 600 /etc/nginx/ssl/\$DOMAIN.key && echo 'CERT OK'\r"
expect "# "

# Write nginx config for glm.tang74.top with HTTPS
send "cat > /etc/nginx/sites-available/glm2api.conf << 'NGX'\nserver {\n    listen 80;\n    server_name glm.tang74.top;\n    return 301 https://\$server_name\$request_uri;\n}\n\nserver {\n    listen 443 ssl;\n    server_name glm.tang74.top;\n\n    ssl_certificate /etc/nginx/ssl/glm.tang74.top.crt;\n    ssl_certificate_key /etc/nginx/ssl/glm.tang74.top.key;\n    ssl_protocols TLSv1.2 TLSv1.3;\n\n    client_max_body_size 100M;\n\n    location / {\n        proxy_pass http://127.0.0.1:8001;\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade \$http_upgrade;\n        proxy_set_header Connection \"upgrade\";\n        proxy_set_header Host \$host;\n        proxy_set_header X-Real-IP \$remote_addr;\n        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto \$scheme;\n        proxy_buffering off;\n        proxy_read_timeout 600s;\n    }\n}\nNGX\r"
expect "# "

# Test and reload nginx
send "nginx -t 2>&1 && systemctl reload nginx && echo 'NGINX OK'\r"
expect "# "

# Test API through nginx
send "curl -sk https://127.0.0.1/health 2>&1\r"
expect "# "

send "echo '=== DONE ==='\r"
expect "# "
send "exit\r"
expect eof
