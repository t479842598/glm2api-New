#!/usr/bin/expect -f
set timeout 20
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@23.95.78.148
expect "password:"
send "TANGlidong24ban\r"
expect "# "

# Step 1: Get login response
send "curl -s -X POST http://127.0.0.1:8001/admin/api/login -H 'Content-Type: application/json' -d '{\"key\":\"glm2api-admin\"}' > /tmp/login.json 2>&1\r"
expect "# "
send "python3 -c 'import json; d=json.load(open(\"/tmp/login.json\")); print(\"code:\", d.get(\"code\")); print(\"token:\", d.get(\"data\",{}).get(\"_session_token\",\"MISSING\")[:50])'\r"
expect "# "

# Step 2: Extract token and test
send "TOKEN=\$(python3 -c 'import json; print(json.load(open(\"/tmp/login.json\")).get(\"data\",{}).get(\"_session_token\",\"\"))')\r"
expect "# "
send "echo TOKEN=\$TOKEN\r"
expect "# "
send "curl -s -H \"x-admin-session: \$TOKEN\" http://127.0.0.1:8001/admin/api/overview 2>&1 | head -c 200\r"
expect "# "

send "exit\r"
expect eof
