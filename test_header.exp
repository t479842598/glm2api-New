#!/usr/bin/expect -f
set timeout 20
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@23.95.78.148
expect "password:"
send "TANGlidong24ban\r"
expect "# "

# Test directly to backend (bypass nginx)
send "TOKEN=\$(curl -s -D - -X POST http://127.0.0.1:8001/admin/api/login -H 'Content-Type: application/json' -d '{\"key\":\"glm2api-admin\"}' 2>&1 | python3 -c 'import sys,json; print(json.load(sys.stdin).get(\"data\",{}).get(\"_session_token\",\"\"))')\r"
expect "# "
send "echo token=\$TOKEN\r"
expect "# "
send "curl -s -H \"x-admin-session: \$TOKEN\" http://127.0.0.1:8001/admin/api/overview 2>&1 | head -c 300\r"
expect "# "

# Test through nginx
send "curl -sk -H \"x-admin-session: \$TOKEN\" https://glm2api.274747.xyz/admin/api/overview 2>&1 | head -c 300\r"
expect "# "

send "exit\r"
expect eof
